        </mxCell>
        <mxCell id="25" value="Stage 1 (R): Class-Conditional Rarity" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1050" y="125" width="640" height="30" as="geometry" />
        </mxCell>
        <mxCell id="26" value="Count attribute values within each class.&lt;br&gt;&lt;b&gt;R_i,a = (1 / (n_a(v_i,a | y_i) + eps))^alpha&lt;/b&gt;&lt;br&gt;Rare real source attributes receive larger source-selection scores." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#B7DDB1;strokeWidth=1;fontSize=16;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="1055" y="165" width="435" height="78" as="geometry" />
        </mxCell>
        <mxCell id="27" value="class y&lt;br&gt;fabric: low count&lt;br&gt;metal: high count" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F7FFF7;strokeColor=#5BA58B;strokeWidth=2;fontSize=15;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="1520" y="165" width="160" height="78" as="geometry" />
        </mxCell>

        <mxCell id="28" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FDECEC;strokeColor=#D64545;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1020" y="295" width="700" height="145" as="geometry" />
        </mxCell>
        <mxCell id="29" value="Stage 2 (P): Generated-Data Frequency Penalty" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1050" y="305" width="640" height="30" as="geometry" />
        </mxCell>
        <mxCell id="30" value="Use source and generated counts.&lt;br&gt;&lt;b&gt;n_hat_a(v) = n_src_a(v) + n_gen_a(v)&lt;/b&gt;&lt;br&gt;&lt;b&gt;P_i,a = -lambda n_hat_a(v_i,a) / sum_v n_hat_a(v)&lt;/b&gt;&lt;br&gt;Downweight values already supplied by generated repair data." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#F3B7B7;strokeWidth=1;fontSize=15;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="1055" y="342" width="485" height="84" as="geometry" />
        </mxCell>
        <mxCell id="31" value="D_gen coverage&lt;br&gt;fabric already common&lt;br&gt;avoid redundancy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF7F7;strokeColor=#D64545;strokeWidth=2;fontSize=15;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="1570" y="345" width="120" height="78" as="geometry" />
        </mxCell>

        <mxCell id="32" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF4D6;strokeColor=#D4A252;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1020" y="475" width="700" height="145" as="geometry" />
        </mxCell>
        <mxCell id="33" value="Stage 3 (C): Soft Class Balance and Greedy Selection" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1050" y="485" width="640" height="30" as="geometry" />
        </mxCell>
        <mxCell id="34" value="Maintain class coverage during selection.&lt;br&gt;&lt;b&gt;C_c^(k) = w (t - n_c^(k)) / t&lt;/b&gt;&lt;br&gt;&lt;b&gt;s_tilde_i^(k) = sum_a(R_i,a + P_i,a) + C_c^(k)&lt;/b&gt;&lt;br&gt;At each step, choose the highest adjusted score." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#E8D086;strokeWidth=1;fontSize=15;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="1055" y="522" width="505" height="84" as="geometry" />
        </mxCell>
        <mxCell id="35" value="selected counts&lt;br&gt;class deficits get bonus&lt;br&gt;overfilled classes get penalty" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFBEA;strokeColor=#D4A252;strokeWidth=2;fontSize=14;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
