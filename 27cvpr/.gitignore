# Root LaTeX build products; keep manuscript source.
/main.*
/AttriSelect.*
!/AttriSelect.tex
/*.pdf
/backup/*.pdf

# Preferred location for local LaTeX build products.
/build_artifacts/*
!/build_artifacts/.gitkeep

# Scratch LaTeX products.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.ptc
*.pdf
*.synctex.gz
