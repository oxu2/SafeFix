\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Overview of SafeFix\xspace  }. We propose a targeted model repair pipeline that identifies rare-case failures, generates attribute-specific synthetic images using a conditional diffusion model, filters them via a large vision--language model, and retrains the model to improve accuracy and fix rare-case bugs.}}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:overview}{{2}{4}{\textbf {Overview of \model }. We propose a targeted model repair pipeline that identifies rare-case failures, generates attribute-specific synthetic images using a conditional diffusion model, filters them via a large vision--language model, and retrains the model to improve accuracy and fix rare-case bugs}{figure.caption.2}{}}
