# Root LaTeX build products; keep manuscript source and the rendered PDF.
/main.*
!/main.tex
!/main.pdf

# Preferred location for local LaTeX build products.
/build_artifacts/*
!/build_artifacts/.gitkeep

# Scratch LaTeX products.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.ptc
*.synctex.gz
